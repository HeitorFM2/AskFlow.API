{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=AskFlow;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_LOCAL_DEV_KEY_AT_LEAST_32_BYTES",
    "Issuer": "AskFlow.API",
    "Audience": "AskFlow.Client",
    "ExpiresInMinutes": 15,
    "RefreshTokenExpiresInDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
